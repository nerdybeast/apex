rules_version = '2';

// APEX Firestore security rules.
//
// Solo-mode: ownerId == request.auth.uid. Coach support is post-v1; rules
// will gain a layered check then. Lifts are seeded read-only; preloaded
// program templates are world-readable to authenticated users.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /lifts/{liftId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /maxes/{id} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /programTemplates/{id} {
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || resource.data.isPreloaded == true);
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.isPreloaded == false;
      allow update, delete: if request.auth != null
                            && resource.data.ownerId == request.auth.uid;
    }

    match /blocks/{id} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /sessions/{id} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /meets/{id} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
